# Optional. Copy to keystore.properties (git-ignored) to sign release builds with your own key.
# Without it, `gradlew assembleRelease` signs with the local Android debug key.
#
# Create a key once with:
#   keytool -genkeypair -v -keystore frame-release.jks -alias frame -keyalg RSA -keysize 2048 -validity 10000
#
# Paths are relative to the launcher/ folder.
storeFile=frame-release.jks
storePassword=change-me
keyAlias=frame
keyPassword=change-me
